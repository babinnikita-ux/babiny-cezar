{
  "name": "@pat-lewczuk/cezar",
  "version": "0.1.3",
  "description": "Local cockpit for running and tracking AI agent tasks in your repo. Uses your logged-in `claude` CLI and `gh` — zero config, zero database.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cezar": "dist/index.js",
    "cez": "dist/index.js"
  },
  "files": [
    "dist",
    "web",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build --config web/app/vite.config.ts",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config web/app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/app/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/cezar"
  },
  "publishConfig": {
    "access": "public"
  }
}
