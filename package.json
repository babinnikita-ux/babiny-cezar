{
  "name": "@pat-lewczuk/cezar",
  "version": "0.1.3",
  "description": "Local cockpit for running and tracking AI agent tasks in your repo. Uses your logged-in `claude` CLI and `gh` — zero config, zero database.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cezar": "dist/index.js",
    "cez": "dist/index.js"
  },
  "files": [
    "dist",
    "web/index.html",
    "web/app.js",
    "web/style.css",
    "web/open-mercato.svg",
    "web/dist",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "vite build --config web/app/vite.config.ts",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config web/app/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "sh .ai/scripts/e2e.sh",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:web": "tsc --noEmit -p web/app/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/cezar"
  },
  "publishConfig": {
    "access": "public"
  }
}
